{
  "name": "@zakkster/lite-aabb",
  "version": "1.2.0",
  "description": "Zero-GC 2D axis-aligned bounding box primitives. Flat Float32Array(4) format [minX, minY, maxX, maxY], every op writes into a caller-provided out buffer — no per-frame allocation. ~100 lines, zero deps, ESM only.",
  "type": "module",
  "main": "./Aabb.js",
  "module": "./Aabb.js",
  "types": "./Aabb.d.ts",
  "exports": {
    ".": {
      "types": "./Aabb.d.ts",
      "node": "./Aabb.js",
      "import": "./Aabb.js",
      "default": "./Aabb.js"
    }
  },
  "files": [
    "Aabb.js",
    "Aabb.d.ts",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --expose-gc --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "torture": "node --expose-gc test/torture.mjs",
    "verify": "npm test && npm run torture"
  },
  "keywords": [
    "aabb",
    "bounding-box",
    "axis-aligned",
    "collision",
    "broadphase",
    "spatial",
    "geometry",
    "2d",
    "math",
    "zero-gc",
    "allocation-free",
    "typed-array",
    "float32array",
    "twitch-extension",
    "canvas",
    "webgl",
    "webgpu",
    "game-dev"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.12.0",
    "@zakkster/lite-leak": "^1.8.0"
  },
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "homepage": "https://github.com/PeshoVurtoleta/lite-aabb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-aabb.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-aabb/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "sideEffects": false
}
